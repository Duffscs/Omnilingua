<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Omnilingua.Dotnet</PackageId><Version>9.9.9</Version><IsOmnilinguaPackage>true</IsOmnilinguaPackage>
    <GeneratePackageOnBuild>$(PublishLocalPackages)</GeneratePackageOnBuild>
    <PackageOutputPath>$(LocalNugetFeed)</PackageOutputPath>
    <Description>SDK Omnilingua pour les contrats .NET.</Description>
  </PropertyGroup>
</Project>
