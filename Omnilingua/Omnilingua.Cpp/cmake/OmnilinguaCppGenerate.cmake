include_guard(GLOBAL)
set(OMNILINGUA_CPP_PYTHON_PATH "" CACHE PATH "Dossier contenant le module Python clang")
set(OMNILINGUA_CPP_LIBCLANG "" CACHE FILEPATH "Bibliothèque libclang à utiliser")
set(OMNILINGUA_CPP_SYSTEM_INCLUDES "" CACHE STRING "Headers système compatibles avec libclang, séparés par des points-virgules")
set(OMNILINGUA_CPP_CLANG_ARGUMENTS "" CACHE STRING "Options supplémentaires du parseur Clang")

function(omnilingua_generate_contracts target)
    get_filename_component(sdk_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}")
    target_include_directories(${target} PRIVATE "${generated_dir}")
    file(GLOB_RECURSE local_headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.h" "${CMAKE_CURRENT_SOURCE_DIR}/*.hpp")
    foreach(candidate IN LISTS local_headers)
        cmake_path(IS_PREFIX CMAKE_CURRENT_BINARY_DIR "${candidate}" NORMALIZE inside_build)
        if(inside_build)
            list(REMOVE_ITEM local_headers "${candidate}")
        endif()
    endforeach()
    set(system_includes ${OMNILINGUA_CPP_SYSTEM_INCLUDES})
    if(NOT system_includes)
        set(system_includes ${CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES})
    endif()
    set(arguments --include "${sdk_root}/include")
    foreach(directory IN LISTS system_includes)
        list(APPEND arguments --system-include "${directory}")
    endforeach()
    foreach(argument IN LISTS OMNILINGUA_CPP_CLANG_ARGUMENTS)
        list(APPEND arguments "--extra-arg=${argument}")
    endforeach()
    set(names)
    foreach(header IN LISTS ARGN)
        get_filename_component(header "${header}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        get_filename_component(name "${header}" NAME_WE)
        if(name IN_LIST names)
            message(FATAL_ERROR "Les headers générés doivent avoir des noms distincts : ${name}")
        endif()
        list(APPEND names "${name}")
        set(output "${generated_dir}/${name}.g.h")
        add_custom_command(OUTPUT "${output}"
            COMMAND "${CMAKE_COMMAND}" -E env
                "PYTHONPATH=${OMNILINGUA_CPP_PYTHON_PATH}"
                "LIBCLANG_LIBRARY_FILE=${OMNILINGUA_CPP_LIBCLANG}"
                "${Python3_EXECUTABLE}" "${sdk_root}/generator/generate_contract.py"
                --header "${header}" --output "${output}" ${arguments}
            DEPENDS "${header}" ${local_headers} "${sdk_root}/generator/generate_contract.py"
            VERBATIM)
        target_sources(${target} PRIVATE "${output}")
    endforeach()
endfunction()

function(omnilingua_add_plugin target)
    cmake_parse_arguments(PLUGIN "" "" "SOURCES;HEADERS" ${ARGN})
    add_library(${target} SHARED ${PLUGIN_SOURCES})
    target_link_libraries(${target} PRIVATE Omnilingua::Cpp)
    if(PLUGIN_HEADERS)
        omnilingua_generate_contracts(${target} ${PLUGIN_HEADERS})
    endif()
endfunction()
